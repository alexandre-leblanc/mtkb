{
  "configVersion": 1,
  "startup": {
    "mode": "windowed"
  },
  "browserData": {
    "directory": null,
    "clearCache": {
      "onStartup": false,
      "onExit": false
    },
    "clearWebsiteData": {
      "onStartup": false,
      "onExit": false
    }
  },
  "tabs": [
    {
      "id": "project",
      "name": "Project",
      "url": "https://github.com/alexandre-leblanc/multi-tab-kiosk-browser",
      "localIcon": "icons/app.png",
      "iconPreference": "local",
      "allowPopups": false
    },
    {
      "id": "home-assistant",
      "name": "Home Assistant",
      "url": "https://www.home-assistant.io/",
      "iconPreference": "website",
      "allowPopups": false
    },
    {
      "id": "donetick",
      "name": "Donetick",
      "url": "https://github.com/donetick/donetick",
      "iconPreference": "website",
      "allowPopups": false
    },
    {
      "id": "wikipedia",
      "name": "Wikipedia",
      "url": "https://www.wikipedia.org/",
      "iconPreference": "website",
      "allowPopups": false
    },
    {
      "id": "youtube",
      "name": "YouTube",
      "url": "https://www.youtube.com/",
      "iconPreference": "website",
      "allowPopups": false
    },
    {
      "id": "spotify",
      "name": "Spotify",
      "url": "https://open.spotify.com/",
      "iconPreference": "website",
      "allowPopups": false
    }
  ],
  "defaultTheme": "dark",
  "themes": {
    "dark": {
      "toolbarBackground": "#181818",
      "textColor": "#cccccc",
      "navBackground": "#252525",
      "navBorder": "#383838",
      "navActiveBackground": "#3a3a3a",
      "tabBackground": "#222222",
      "tabTextColor": "#999999",
      "selectedTabBackground": "#0066cc",
      "selectedTabTextColor": "#ffffff",
      "separatorColor": "#333333"
    },
    "light": {
      "toolbarBackground": "#f0f0f0",
      "textColor": "#333333",
      "navBackground": "#ffffff",
      "navBorder": "#cccccc",
      "navActiveBackground": "#dddddd",
      "tabBackground": "#e2e2e2",
      "tabTextColor": "#444444",
      "selectedTabBackground": "#0066cc",
      "selectedTabTextColor": "#ffffff",
      "separatorColor": "#cccccc"
    }
  }
}
