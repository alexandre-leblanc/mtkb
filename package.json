{
  "name": "mtkb",
  "productName": "Multi-Tab Kiosk Browser",
  "version": "1.0.0",
  "description": "A configurable multi-tab browser for kiosk and dashboard applications",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win nsis"
  },
  "keywords": [
    "electron",
    "kiosk",
    "browser",
    "multi-tab",
    "dashboard"
  ],
  "author": "Alex LeBlanc",
  "license": "SEE LICENSE IN LICENSE",
  "type": "commonjs",
  "devDependencies": {
    "electron": "45.1.0",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.alexleblanc.mtkb",
    "productName": "Multi-Tab Kiosk Browser",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "popup-close-preload.js",
      "popup-close.html",
      "popup-overlay.html",
      "config.example.json",
      "icons/**/*",
      "package.json",
      "README.md",
      "CONFIGURATION.md",
      "DATA-AND-PRIVACY.md",
      "LICENSE"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Multi-Tab Kiosk Browser",
      "deleteAppDataOnUninstall": false
    }
  }
}
