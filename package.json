{
  "name": "mtkb",
  "productName": "Multi-Tab Kiosk Browser",
  "desktopName": "com.alexleblanc.mtkb",
  "version": "1.0.0",
  "description": "A configurable multi-tab browser for kiosk and dashboard applications",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win nsis",
    "dist:linux": "electron-builder --linux AppImage deb rpm"
  },
  "keywords": [
    "electron",
    "kiosk",
    "browser",
    "multi-tab",
    "dashboard"
  ],
  "author": "Alex LeBlanc",
  "license": "SEE LICENSE IN LICENSE",
  "type": "commonjs",
  "devDependencies": {
    "electron": "45.1.0",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.alexleblanc.mtkb",
    "productName": "Multi-Tab Kiosk Browser",
    "directories": {
      "output": "dist"
    },
    "afterPack": "scripts/after-pack-linux.js",
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "popup-close-preload.js",
      "popup-close.html",
      "popup-overlay.html",
      "config.example.json",
      "icons/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "mtkb-Setup-${version}.${ext}",
      "extraFiles": [
        "README.md",
        "CONFIGURATION.md",
        "DATA-AND-PRIVACY.md",
        "LICENSE"
      ],
      "icon": "build/icon.svg"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb",
        "rpm"
      ],
      "category": "Utility",
      "maintainer": "Alex LeBlanc <62810838+alexandre-leblanc@users.noreply.github.com>",
      "syncDesktopName": true,
      "artifactName": "mtkb-${version}-${arch}.${ext}",
      "extraFiles": [
        "README.md",
        "CONFIGURATION.md",
        "DATA-AND-PRIVACY.md",
        "LICENSE"
      ]
    },
    "deb": {
      "packageCategory": "utils"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Multi-Tab Kiosk Browser",
      "deleteAppDataOnUninstall": false
    }
  }
}
